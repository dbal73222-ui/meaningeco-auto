XFILE_LOGIN_URL=https://admin.xfile.example.com/login
XFILE_USERNAME=
XFILE_PASSWORD=
XFILE_POSTING_URLS=https://admin.xfile.example.com/postings/123,https://admin.xfile.example.com/postings/456
XFILE_HEADLESS=true
# 결과 JSON/CSV 저장 위치 (미설정시 기본값 "output")
XFILE_OUTPUT_DIR=output

# --- 경력 데이터 보강 (선택 기능, 미설정 시 자동으로 꺼짐) ---
# expile-backend API 기본 URL. 비워두면 경력 보강 기능 전체가 비활성화됨
XFILE_API_BASE_URL=
# 비워두면 XFILE_USERNAME/XFILE_PASSWORD를 그대로 사용함
XFILE_API_EMAIL=
XFILE_API_PASSWORD=
# 이 경력 수 이상이면 "슈퍼바이저 후보"로 표시. 비워두면 표시 기능 자체가 꺼짐 (대표님 확인 전까지 비워둘 것)
XFILE_SUPERVISOR_CAREER_THRESHOLD=
